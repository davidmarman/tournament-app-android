<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorPrimary"
    app:cardBackgroundColor="@color/glow_card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivJugadorFoto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:background="@color/glow_background_start"
            android:padding="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#20FFFFFF"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            android:src="@android:drawable/ic_menu_myplaces" />

        <TextView
            android:id="@+id/tvJugadorNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Nombre Jugador"
            android:textStyle="bold"
            android:textColor="@color/glow_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvBadgeCapitanJugador"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:text="C"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/glow_text_primary"
            android:gravity="center"
            android:background="@drawable/bg_capitan_circle"
            android:visibility="gone"
            android:layout_marginEnd="12dp"
            tools:visibility="visible" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvAmarilla"
            android:layout_width="32dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFEB3B">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageButton
                    android:id="@+id/btnAmarilla"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="Tarjeta Amarilla" />
                <TextView
                    android:id="@+id/tvAmarillax2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="x2"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvRoja"
            android:layout_width="32dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F44336">
            <ImageButton
                android:id="@+id/btnRoja"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Tarjeta Roja" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/glow_background_start"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp">

            <Button
                android:id="@+id/btnMenosGol"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="-"
                android:textColor="@color/glow_text_primary"
                android:textSize="20sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <TextView
                android:id="@+id/tvGolesContador"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:gravity="center"
                android:textColor="@color/glow_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMasGol"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="+"
                android:textColor="#4CAF50"
                android:textSize="20sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>