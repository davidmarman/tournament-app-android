<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivItemLogo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:background="@color/glow_background_start"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary"
            android:src="@android:drawable/ic_menu_gallery"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvBadgeCapitan"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:text="C"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/glow_background_start"
            android:gravity="center"
            android:background="@drawable/bg_capitan_circle"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@+id/ivItemLogo"
            app:layout_constraintEnd_toEndOf="@+id/ivItemLogo"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvItemNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Nombre"
        android:textSize="12sp"
        android:textColor="@color/glow_text_primary" />

</LinearLayout>