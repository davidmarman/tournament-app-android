<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glow_screen"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/btnOpcionesEquipo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/glow_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Opciones del equipo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDetalleLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@color/glow_card_surface"
                android:padding="4dp"
                app:strokeWidth="2dp"
                app:strokeColor="?attr/colorPrimary"
                app:shapeAppearanceOverlay="@style/CornerRounded" />

            <TextView
                android:id="@+id/tvDetalleNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Nombre Equipo"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/glow_text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próximo partido:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/glow_text_primary"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProximoPartido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:cardBackgroundColor="?attr/colorControlHighlight"
            app:cardElevation="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvRivalNombre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Equipo Rival"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/glow_text_primary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivRivalLogo"/>

                <TextView
                    android:id="@+id/tvTorneoFecha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Nombre Torneo\nFecha"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/glow_text_secondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvRivalNombre"
                    app:layout_constraintEnd_toStartOf="@+id/ivRivalLogo"/>

                <ImageView
                    android:id="@+id/ivRivalLogo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerInside"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Líderes del Equipo:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/glow_text_primary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/glow_card_surface"
                android:padding="8dp"
                android:layout_marginEnd="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚽ Máx Goles" android:textSize="11sp" android:textStyle="bold" android:textColor="#4CAF50"/>
                <TextView android:id="@+id/tvLiderGoles" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-\n0" android:gravity="center" android:textSize="12sp" android:textColor="@color/glow_text_primary" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/glow_card_surface"
                android:padding="8dp"
                android:layout_marginHorizontal="2dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🟨 Amarillas" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFB300"/>
                <TextView android:id="@+id/tvLiderAmarillas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-\n0" android:gravity="center" android:textSize="12sp" android:textColor="@color/glow_text_primary" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/glow_card_surface"
                android:padding="8dp"
                android:layout_marginStart="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🟥 Rojas" android:textSize="11sp" android:textStyle="bold" android:textColor="#E53935"/>
                <TextView android:id="@+id/tvLiderRojas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-\n0" android:gravity="center" android:textSize="12sp" android:textColor="@color/glow_text_primary" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Torneos Inscrito:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/glow_text_primary"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTorneosInscrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vitrina del Equipo:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/glow_text_primary"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPalmaresEquipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:visibility="visible"
                tools:listitem="@layout/item_palmares" />

            <TextView
                android:id="@+id/tvPalmaresVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aún no hay trofeos en las vitrinas."
                android:textColor="@color/glow_text_secondary"
                android:textSize="14sp"
                android:visibility="visible" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plantilla:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/glow_text_primary"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvJugadores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp"
            tools:listitem="@layout/item_perfil_simple" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>