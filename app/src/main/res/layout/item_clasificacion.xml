<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/selector_fila_clasificacion"> <TextView
    android:id="@+id/tvRank"
    android:layout_width="24dp"
    android:layout_height="wrap_content"
    android:text="1"
    android:textStyle="bold"
    android:textColor="@color/glow_text_primary"/>

    <ImageButton
        android:id="@+id/btnExpulsarEquipo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:visibility="gone"
        app:tint="#D32F2F" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivEquipoLogo"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:background="@color/glow_background_start"
        app:shapeAppearanceOverlay="@style/CornerRounded"
        android:src="@android:drawable/ic_menu_gallery" />

    <TextView
        android:id="@+id/tvEquipoNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="Nombre Equipo"
        android:textColor="@color/glow_text_primary"
        android:ellipsize="end"
        android:maxLines="1"/>

    <LinearLayout
        android:id="@+id/layoutDetalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView android:id="@+id/tvPG" android:text="G" style="@style/EstadisticaStyle" />
        <TextView android:id="@+id/tvPE" android:text="E" style="@style/EstadisticaStyle" />
        <TextView android:id="@+id/tvPP" android:text="P" style="@style/EstadisticaStyle" />
        <TextView android:id="@+id/tvGF" android:text="GF" style="@style/EstadisticaStyle" />
        <TextView android:id="@+id/tvGC" android:text="GC" style="@style/EstadisticaStyle" />
    </LinearLayout>

    <TextView android:id="@+id/tvPJ" android:text="PJ" style="@style/EstadisticaStyle" />
    <TextView android:id="@+id/tvPts" android:text="Pts" android:textStyle="bold" style="@style/EstadisticaStyle" />

</LinearLayout>