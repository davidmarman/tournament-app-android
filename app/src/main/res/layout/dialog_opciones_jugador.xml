<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/glow_card_surface"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#40FFFFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvNombreJugadorOpciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre del Jugador"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/glow_text_primary"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerPerfil"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver Perfil"
        android:textColor="@color/glow_text_primary"
        app:icon="@android:drawable/ic_menu_info_details"
        app:iconTint="?attr/colorPrimary"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCederCapitania"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ceder Capitania"
        android:textColor="@color/glow_text_primary"
        app:icon="@android:drawable/ic_menu_info_details"
        app:iconTint="?attr/colorPrimary"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExpulsar"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expulsar del Equipo"
        android:textColor="#D32F2F"
        app:icon="@android:drawable/ic_menu_delete"
        app:iconTint="#D32F2F"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="24dp"/>

</LinearLayout>