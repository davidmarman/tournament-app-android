<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDetalleTorneoLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CornerRounded"
                android:src="@android:drawable/ic_menu_gallery"
                android:background="#E0E0E0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvDetalleTorneoNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre Torneo"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tvDetalleTorneoDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descripción del torneo..."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/layoutAdminPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#E3F2FD"
                app:strokeWidth="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_secure"
                        app:tint="#1976D2" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Código de Invitación:"
                        android:textColor="#1976D2"
                        android:layout_marginStart="8dp"/>

                    <TextView
                        android:id="@+id/tvAdminCodigo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TRN-XXXX"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#1976D2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Co-Administradores del Torneo:"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageButton
                        android:id="@+id/btnAgregarAdmin"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_input_add"
                        android:background="@android:drawable/screen_background_light_transparent"
                        app:tint="#1976D2"
                        android:layout_marginEnd="8dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAdministradores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerarCalendario"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="GENERAR CALENDARIO DE PARTIDOS"
                app:icon="@android:drawable/ic_menu_today"
                app:backgroundTint="#FF9800" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinalizarTorneo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FINALIZAR TORNEO Y ENTREGAR PREMIOS"
                android:textColor="#4CAF50"
                app:strokeColor="#4CAF50"
                android:layout_marginTop="8dp"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconTint="#4CAF50" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarTorneo"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ELIMINAR ESTE TORNEO"
                android:textColor="#D32F2F"
                android:layout_marginTop="8dp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="#D32F2F" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTorneoFinalizado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Torneo Finalizado"
            android:layout_gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clasificación:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DDDDDD">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:background="#EEEEEE">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Equipo"
                        android:textStyle="bold"
                        android:textColor="@color/black"/>
                    <ImageButton
                        android:id="@+id/btnToggleStats"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_add"
                        app:tint="#666666" />

                    <LinearLayout
                        android:id="@+id/headerDetalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="G" android:gravity="center" android:textStyle="bold"/>
                        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="E" android:gravity="center" android:textStyle="bold"/>
                        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="P" android:gravity="center" android:textStyle="bold"/>
                        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="GF" android:gravity="center" android:textStyle="bold"/>
                        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="GC" android:gravity="center" android:textStyle="bold"/>
                    </LinearLayout>


                    <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="PJ" android:gravity="center" android:textStyle="bold"/>
                    <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="Pts" android:gravity="center" android:textStyle="bold"/>


                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvClasificacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvTituloJornada"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jornada 1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_selector_jornada"
                android:padding="4dp">

                <ImageButton
                    android:id="@+id/btnJornadaAnterior"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_media_previous"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#1976D2" />

                <TextView
                    android:id="@+id/tvContadorJornada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 / 10"
                    android:layout_marginHorizontal="8dp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />

                <ImageButton
                    android:id="@+id/btnJornadaSiguiente"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_media_next"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#1976D2" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPartidosJornada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Líderes Estatales del Torneo:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:textColor="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#EEEEEE"
                android:padding="10dp"
                android:layout_marginEnd="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚽ Pichichi" android:textSize="11sp" android:textStyle="bold" android:textColor="#4CAF50"/>
                <TextView android:id="@+id/tvTorneoPichichi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-\n0 G" android:gravity="center" android:textSize="12sp" android:textColor="@color/black" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#EEEEEE"
                android:padding="10dp"
                android:layout_marginHorizontal="2dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🟨 Tarjetas" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFB300"/>
                <TextView android:id="@+id/tvTorneoAmarillas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-\n0 🟨" android:gravity="center" android:textSize="12sp" android:textColor="@color/black" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#EEEEEE"
                android:padding="10dp"
                android:layout_marginStart="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🟥 Rojas" android:textSize="11sp" android:textStyle="bold" android:textColor="#E53935"/>
                <TextView android:id="@+id/tvTorneoRojas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-\n0 🟥" android:gravity="center" android:textSize="12sp" android:textColor="@color/black" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>