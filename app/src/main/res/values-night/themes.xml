<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TournamentApp" parent="Theme.TournamentApp.Blue" />

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CornerRounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="EstadisticaStyle">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/glow_text_secondary</item>
    </style>

    <style name="Base.Theme.TournamentApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/glow_background_start</item>
        <item name="colorSurface">@color/glow_card_surface</item>
        <item name="android:textColorPrimary">@color/glow_text_primary</item>
        <item name="android:textColorSecondary">@color/glow_text_secondary</item>
    </style>

    <style name="Theme.TournamentApp.Blue" parent="Base.Theme.TournamentApp">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_dark</item>
        <item name="colorControlHighlight">@color/accent_blue_glow</item>
    </style>

    <style name="Theme.TournamentApp.Cyan" parent="Base.Theme.TournamentApp">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/accent_cyan_dark</item>
        <item name="colorControlHighlight">@color/accent_cyan_glow</item>
    </style>

    <style name="Theme.TournamentApp.Green" parent="Base.Theme.TournamentApp">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryVariant">@color/accent_green_dark</item>
        <item name="colorControlHighlight">@color/accent_green_glow</item>
    </style>
</resources>